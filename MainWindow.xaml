<Window x:Class="FileOrganizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart File Organizer" Height="300" Width="500"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Button x:Name="OrganizeButton" Grid.Row="0" Content="Select Folder &amp; Organize" 
                Height="40" Background="DarkSlateGray" Foreground="White" 
                FontWeight="Bold" FontSize="14" Click="OrganizeButton_Click"/>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock x:Name="StatusLabel" Text="System Ready. Standing by..." 
                       FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,10" Foreground="#333333"/>

            <ProgressBar x:Name="ProcessingProgress" Height="20" Minimum="0" Maximum="100" Value="0"/>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="Warning: Heavy file operations run on background threads." 
                   FontStyle="Italic" Foreground="Gray" HorizontalAlignment="Center"/>
    </Grid>
</Window>